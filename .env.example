# CampusOS environment variables. Copy to .env.local (gitignored) and fill in.

# Neon Postgres. Pooled URL for the app; direct (non-pooler host) URL for migrations.
# Use a separate Neon branch per environment: main (production) / staging / preview-<pr> / dev-<name>.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Isolated database for integration and E2E tests. Tests DROP and recreate it on every run, so its name must
# start with "campusos_test". Same Neon endpoint is fine: postgresql://…/campusos_test?sslmode=require
TEST_DATABASE_URL=
TEST_DATABASE_URL_UNPOOLED=

# Session signing secret, ≥32 chars: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (must match the browser origin for cookies and OAuth redirects).
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google sign-in. Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID → Web application.
#   Authorised JavaScript origin: http://localhost:3000
#   Authorised redirect URI:      http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google account made Super Admin of the demo tenant by `npm run db:seed`.
CAMPUSOS_BOOTSTRAP_ADMIN_EMAIL=

# Deployment environment: development | test | staging | production
CAMPUSOS_ENV=development
# One-click synthetic demo personas (password sign-in for seeded demo users only). Refused when CAMPUSOS_ENV=production.
CAMPUSOS_DEMO_MODE=true

# Scheduled dispatch of queued emails (GET /api/cron/notifications with "Authorization: Bearer <secret>").
# Leave empty to disable the endpoint. Until an email provider is configured (Phase 11), dispatch records messages
# as sent without delivering them.
CRON_SECRET=
